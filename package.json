    "test:grpc:phase4a": "tsc -b --noEmit && vitest run src/shared/grpc/grpcAuthPolicy.test.ts src/shared/grpc/grpcTlsPolicy.test.ts src/shared/grpc/grpcRedaction.test.ts src/shared/grpc/grpcSecretPolicy.test.ts src/shared/grpc/requestValidation.test.ts src/features/grpc/grpcStudioTypes.test.ts src-server/grpc/grpc-service.test.ts src-server/grpc/grpc-service.call.test.ts src-server/grpc/grpc-service.dynamicProtoCodec.test.ts src-server/grpc/grpc-stream-service.test.ts",
    "test:grpc:phase4bc": "tsc -b --noEmit && vitest run src/shared/grpc/grpcTlsPolicy.test.ts src/features/grpc/utils/resolveGrpcTabConnection.test.ts src/features/grpc/utils/grpcMetadataEditor.test.ts src/features/grpc/utils/grpcAuthPreview.test.ts src/features/grpc/hooks/useGrpcTls.test.ts src/features/grpc/hooks/grpcStudioSessionHelpers.test.ts src/features/grpc/hooks/useGrpcStudio.tabs.test.ts src/features/grpc/hooks/useGrpcStudio.reflectDescribe.test.ts src/features/grpc/hooks/useGrpcStudio.protoIngest.test.ts src/features/grpc/hooks/useGrpcStudio.targetCache.test.ts src/features/grpc/hooks/useGrpcStudio.executeUnaryCall.test.ts src/features/grpc/hooks/useGrpcStudio.stream.test.ts src/features/grpc/hooks/useGrpcStudio.schemaDrift.test.ts src/features/grpc/components/GrpcTlsPanel.test.tsx src/features/grpc/components/GrpcAuthPanel.test.tsx src/features/grpc/components/GrpcCallPanel.test.tsx src/features/grpc/components/GrpcCallPanel.auth.test.tsx src/features/grpc/grpcStudioTypes.test.ts",
