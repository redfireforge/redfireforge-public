    "test:grpc:phase4e": "tsc -b --noEmit && vitest run src/shared/grpc/grpcSecretVault.test.ts src/shared/grpc/grpcSecretLeakScan.test.ts src/shared/grpc/grpcRedaction.test.ts src/shared/grpc/grpcSecretPolicy.test.ts src/features/grpc/utils/grpcTabSecretVault.test.ts src/features/grpc/utils/grpcResponseUtils.test.ts src/features/grpc/hooks/grpcStudioSessionHelpers.test.ts src/features/grpc/components/GrpcResponsePanel.test.tsx src/features/grpc/hooks/grpcStudioTabCommands.coverage-gaps.test.ts",
    "test:grpc:phase4f": "tsc -b --noEmit && vitest run src/shared/grpc/grpcTransportErrors.test.ts src/shared/grpc/grpcTlsPolicy.test.ts src-server/grpc/grpcChannelCredentials.test.ts src-server/grpc/grpcTransportEnvelope.test.ts src-server/grpc/grpcClient.test.ts src-server/grpc/descriptorLoader.test.ts src-server/grpc/grpc-service.test.ts src-server/grpc/grpc-service.call.test.ts src-server/grpc/grpc-service.dynamicProtoCodec.test.ts src-server/grpc/grpc-stream-service.test.ts src/features/grpc/hooks/useGrpcTls.test.ts src/features/grpc/components/GrpcTlsPanel.test.tsx",
