{
  "name": "redfire-forge",
  "version": "0.8.5-beta.1",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "redfireforge": "dist-cli/redfireforge.mjs"
  },
  "scripts": {
    "dev": "vite",
    "dev:demo": "cross-env VITE_ENABLE_DEMO_HUB=true vite",
    "dev:grpc": "bash scripts/dev-grpc.sh",
    "dev:prod-slim": "cross-env VITE_ENABLE_DEMO_HUB=false vite",
    "build": "npm run build:prod",
    "build:prod": "tsc -b && cross-env VITE_ENABLE_DEMO_HUB=false vite build --mode production",
    "build:demo": "tsc -b && cross-env VITE_ENABLE_DEMO_HUB=true vite build --mode production.demo",
    "audit:prod-demo-bundle": "node scripts/audit-prod-demo-bundle.mjs",
    "build:cli": "node scripts/build-cli.mjs",
    "build:cli-package": "./scripts/build-cli-package.sh",
    "build:server": "node scripts/build-server.mjs",
    "server": "tsx --tsconfig tsconfig.server.json src-server/index.ts",
    "server:dev": "tsx watch --tsconfig tsconfig.server.json src-server/index.ts",
    "grpc:phase13a:baseline": "node scripts/grpc-phase13-baseline.mjs --out artifacts/grpc-phase13a-baseline.json",
    "grpc:phase13a:gate": "node scripts/grpc-phase13-baseline.mjs --samples=15 --timeout-ms=3500 --max-p95-ms=450 --max-avg-ms=250 --max-error-rate=0.05 --out artifacts/grpc-phase13a-baseline.json",
    "grpc:phase13b:baseline": "node scripts/grpc-phase13-baseline.mjs --out artifacts/grpc-phase13b-baseline.json --probe-grpc-target=127.0.0.1:50051 --probe-samples=3",
    "grpc:phase13b:gate": "node scripts/grpc-phase13-baseline.mjs --samples=15 --timeout-ms=3500 --max-p95-ms=450 --max-avg-ms=250 --max-error-rate=0.05 --out artifacts/grpc-phase13b-baseline.json --probe-grpc-target=127.0.0.1:50051 --probe-samples=3 --require-data-plane",
    "grpc:phase13b:ci": "bash scripts/grpc-phase13b-ci.sh",
    "grpc:transport:parity": "tsx scripts/grpc-transport-parity-matrix.ts",
    "grpc:phase13c:drills": "node scripts/grpc-phase13c-drills.mjs --out artifacts/grpc-phase13c-drills.json",
    "grpc:phase13c:gate": "node scripts/grpc-phase13c-drills.mjs --out artifacts/grpc-phase13c-drills.json --require-live",
    "grpc:phase13d:drills": "node scripts/grpc-phase13d-recovery.mjs --out artifacts/grpc-phase13d-recovery.json",
    "grpc:phase13d:gate": "node scripts/grpc-phase13d-recovery.mjs --out artifacts/grpc-phase13d-recovery.json --require-live",
    "grpc:phase13e:a11y": "node scripts/grpc-phase13e-a11y.mjs --out artifacts/grpc-phase13e-a11y.json",
    "grpc:phase13e:tests": "vitest run src/features/grpc/components/GrpcAdvancedFeaturesPanels.test.tsx",
    "grpc:phase13e:gate": "npm run grpc:phase13e:a11y && npm run grpc:phase13e:tests",
    "grpc:phase13f:observability": "node scripts/grpc-phase13f-observability.mjs --out artifacts/grpc-phase13f-observability.json",
    "grpc:phase13f:tests": "vitest run src-server/grpc/grpcObservabilityTaxonomy.test.ts src-server/grpc/grpcRoutePerformanceTelemetry.test.ts src/shared/grpc/grpcRedaction.coverage-gaps.test.ts",
    "grpc:phase13f:gate": "npm run grpc:phase13f:observability && npm run grpc:phase13f:tests",
    "grpc:phase13h:rollback": "node scripts/grpc-phase13h-rollback-drill.mjs --out artifacts/grpc-phase13h-rollback-drill.json",
    "grpc:phase13h:gate": "node scripts/grpc-phase13h-rollback-drill.mjs --out artifacts/grpc-phase13h-rollback-drill.json --require-live",
    "grpc:soak:gate": "node scripts/grpc-soak-gate.mjs",
    "grpc:phase13i:signoff": "node scripts/grpc-phase13i-ga-signoff.mjs --out artifacts/grpc-phase13i-ga-signoff.json",
    "grpc:phase13i:gate": "node scripts/grpc-phase13i-ga-signoff.mjs --out artifacts/grpc-phase13i-ga-signoff.json",
    "grpc:p1b:acceptance": "bash scripts/grpc-p1b-acceptance.sh",
    "cli": "tsx cli/index.ts",
    "lint": "eslint .",
    "lint:max-lines": "bash scripts/check-max-lines.sh",
    "lint:max-lines:strict": "MAX_LINES=750 bash scripts/check-max-lines.sh",
    "lint:css": "stylelint \"src/**/*.css\"",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:dev:demo": "tauri dev --config src-tauri/tauri.conf.demo.json",
    "tauri:dev:mcp": "tauri dev -- --features mcp-bridge",
    "tauri:build": "tauri build",
    "tauri:build:prod": "tauri build",
    "tauri:build:demo": "tauri build --config src-tauri/tauri.conf.demo.json",
    "test": "vitest run",
    "test:product": "vitest run --project product",
    "test:demo": "vitest run --project demo",
    "test:product:coverage": "RUN_ID=$(date +%Y%m%d-%H%M%S)-$$ && RUN_DIR=.tmp/product-coverage-runs/product-$RUN_ID && mkdir -p \"$RUN_DIR/.tmp\" coverage && vitest run --project product --coverage --maxWorkers=1 --no-file-parallelism --coverage.reportsDirectory=\"$RUN_DIR\" && PRODUCT_COVERAGE_DIR=\"$RUN_DIR\" npx tsx scripts/product-coverage-filter.ts && PRODUCT_COVERAGE_DIR=\"$RUN_DIR\" npx tsx scripts/verify-product-coverage-gaps.ts && cp \"$RUN_DIR/coverage-final.json\" coverage/coverage-final.json && cp \"$RUN_DIR/coverage-summary.json\" coverage/coverage-summary.json && cp \"$RUN_DIR/coverage-final.product.json\" coverage/coverage-final.product.json && cp \"$RUN_DIR/coverage-summary.product.json\" coverage/coverage-summary.product.json",
    "test:product:coverage:fast": "bash scripts/run-product-coverage-fast.sh",
    "verify:product:coverage": "npx tsx scripts/verify-product-coverage-gaps.ts",
    "test:demo:coverage": "bash scripts/run-demo-coverage-full.sh",
    "test:demo:coverage:scope": "bash scripts/run-demo-coverage-scope.sh",
    "test:demo:coverage:file": "bash scripts/run-demo-coverage-file.sh",
    "demo:coverage:status": "bash scripts/demo-coverage-status.sh",
    "demo:e2e:lesson": "bash scripts/run-demo-e2e.sh",
    "verify:demo:coverage": "tsx scripts/verify-demo-coverage-gaps.ts",
    "test:watch": "vitest",
    "test:coverage": "npm run test:product:coverage",
    "test:e2e": "playwright test",
    "test:e2e:balanced:3": "bash scripts/run-e2e-balanced-shard.sh 3",
    "test:e2e:balanced:4": "bash scripts/run-e2e-balanced-shard.sh 4",
    "test:e2e:graphql:clean": "bash ./scripts/run-graphql-e2e-clean.sh",
    "test:e2e:graphql:clean:headed": "bash ./scripts/run-graphql-e2e-clean.sh --headed",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:docker": "E2E_WITH_DOCKER=1 playwright test --project=docker",
    "test:e2e:docker:headed": "E2E_WITH_DOCKER=1 playwright test --project=docker --headed",
    "test:grpc:coverage": "tsc -b --noEmit && vitest run --project product --coverage src/features/grpc src/shared/grpc src-server/grpc src-server/routes/grpc --maxWorkers=1 --no-file-parallelism && tsx scripts/product-coverage-filter.ts && tsx scripts/verify-grpc-coverage-gaps.ts",
    "test:grpc:dev": "bash scripts/test-grpc-dev.sh",
    "test:grpc:dev:advanced": "bash scripts/test-grpc-dev-advanced.sh",
    "test:grpc:fast": "bash scripts/run-grpc-phase-fast.sh",
    "test:grpc:phase:fast": "bash scripts/run-grpc-phase-fast.sh",
    "test:grpc:phase:full": "bash scripts/run-grpc-phase-full.sh",
